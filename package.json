{
  "name": "dsh-advanced-training",
  "version": "0.4.0",
  "private": true,
  "description": "DeepseekHarness voice-model training entry with DDSP, GPT-SoVITS, RVC and Applio backends, material preparation, verified resume and model handoff.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "training",
    "dataset-audit",
    "gpt-sovits",
    "ddsp-svc",
    "rvc",
    "applio"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/integration.mjs && node test/rvc.mjs && node test/rvc-process-tree.mjs && node test/rvc-resume.mjs && node test/applio.mjs",
    "test:local": "node test/local-pipeline.mjs",
    "test:rvc:local": "node test/rvc-local.mjs",
    "test:applio:local": "node test/applio-local.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "src/*.js",
    "py/*.py",
    "cordis.patch.yml",
    "test/*.mjs",
    "test/*.py",
    "README.md",
    "CHANGELOG.md",
    "vendor/**/*.js",
    "vendor/**/*.py",
    "vendor/**/*.json",
    "vendor/**/*.md",
    "vendor/**/*.txt",
    "vendor/**/LICENSE",
    "docs/*.md",
    "training.example.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/InariNGT-Ofiicial/dsh-advanced-training.git"
  }
}
